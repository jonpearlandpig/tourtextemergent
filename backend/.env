MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"
CORS_ORIGINS="*"

# Postgres/Supabase Database
POSTGRES_URL="postgresql://user:password@localhost:5432/tourtext"

# Twilio SMS Integration
# Required for SMS functionality
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# OpenAI Integration (or use EMERGENT_LLM_KEY)
# Required for query processing and response formatting
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
EMERGENT_LLM_KEY=""

# Supabase Storage
# Required for file uploads
# Get credentials from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="tourtext-files"